# ═══════════════════════════════════════════════════
#  안동잇다 환경변수
#  이 파일을 .env로 복사한 뒤 실제 키를 채운다.
#  .env는 절대 커밋하지 않는다.
# ═══════════════════════════════════════════════════

# 한국관광공사 TourAPI
#   발급: https://www.data.go.kr
#   ⚠️ 활용신청 필요 API 3종 — 하나라도 빠지면 그 기능만 조용히 죽는다.
#     - 기초지자체 중심 관광지 정보 (LocgoHubTarService1)  관광지 순위·좌표의 뼈대
#     - 국문 관광정보 서비스 (KorService2)                 사진·주소·음식점. 빠지면 403
#     - 관광사진 정보 (PhotoGalleryService1)               사진 마지막 보충
#     - 영문 관광정보 서비스 (EngService2)                  영문 이름(안동 32건뿐)
#   신청 여부는 응답으로 구분한다.
#     정상    resultCode 0000
#     미신청  HTTP 403 SERVICE_KEY_IS_NOT_REGISTERED_ERROR(30) "등록되지 않은 서비스키"
#   Encoding·Decoding 키 어느 쪽을 넣어도 동작한다(코드가 한 번 디코딩해서 쓴다).
#   서버에서만 접근되며 클라이언트 번들에 포함되지 않는다.
TOUR_API_KEY=

# 카카오맵 JavaScript 키
#   발급: https://developers.kakao.com
#   ⚠️ 브라우저에 노출되는 값이다.
#      카카오 콘솔 > 플랫폼 > Web에서 사용할 도메인을 반드시 등록한다.
#      (개발: http://localhost:3000 / 배포: https://your-domain.vercel.app)
NUXT_PUBLIC_KAKAO_MAP_KEY=

# 안동시 버스정보 API는 인증키가 필요하지 않다.
#   http://bus.andong.go.kr/m01/s04.do
